{
  "kind": "collectionType",
  "collectionName": "practice_logs",
  "info": {
    "singularName": "practice-log",
    "pluralName": "practice-logs",
    "displayName": "Practice Log"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "start": {
      "type": "datetime"
    },
    "stop": {
      "type": "datetime"
    },
    "notes": {
      "type": "blocks"
    },
    "duration": {
      "type": "integer"
    },
    "date": {
      "type": "date"
    },
    "owner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "private": true
    },
    "material": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::task.task",
      "inversedBy": "practice_logs"
    },
    "segments": {
      "type": "json"
    }
  }
}
